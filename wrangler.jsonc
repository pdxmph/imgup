{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imgup",
  "main": "worker/index.ts",
  "compatibility_date": "2025-12-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
