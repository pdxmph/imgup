- if @recents.nil? || @recents.empty?
  %section.recent-empty
    %h2 nothing here yet.
    %p
      the upload album is empty.
      %a{href: "/"} upload one →
- else
  .contact-grid
    - @recents.each_with_index do |r, i|
      - cap = r[:caption].to_s
      - url = r[:image_url].to_s
      - md  = "![#{cap}](#{url})"
      - org = "[[img:#{url}][#{cap}]]"
      - html = "<img src='#{url}' alt='#{cap}' />"
      %article.contact-card
        %span.contact-card__seq= "%02d" % (i + 1)
        %button.contact-card__photo{type: "button",
                                     "data-lightbox-src" => url,
                                     "data-lightbox-alt" => cap,
                                     "aria-label" => "view #{cap.empty? ? 'photo' : cap} larger"}
          .photo-frame
            %img.contact-card__thumb{src: r[:thumb], alt: cap, loading: "lazy"}
        .contact-card__copy-row
          %button.copy-icon-btn{type: "button",
                                  "data-copy-text" => md,
                                  "aria-label" => "copy markdown",
                                  title: "copy markdown"}
            %i.fa-brands.fa-markdown
          %button.copy-icon-btn{type: "button",
                                  "data-copy-text" => org,
                                  "aria-label" => "copy org",
                                  title: "copy org"}
            %i.fa-solid.fa-asterisk
          %button.copy-icon-btn{type: "button",
                                  "data-copy-text" => html,
                                  "aria-label" => "copy html",
                                  title: "copy html"}
            %i.fa-solid.fa-code

