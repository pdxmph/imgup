!!!
%html{lang: "en"}
  %head
    %meta{content: "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    
    %title imgup
    %meta{charset: "utf-8"}/
    %meta{content: "width=device-width, initial-scale=1", name: "viewport"}/
    %link{href: "https://cdn.simplecss.org/simple.min.css", rel: "stylesheet"}/
    = haml :local_css
  
    %script{src: "https://kit.fontawesome.com/96d20ed16f.js", crossorigin: "anonymous"}

    :javascript
      // theme: respect saved choice → falls through to prefers-color-scheme.
      // runs inline before paint to avoid a flash of the wrong theme.
      (function() {
        try {
          var saved = localStorage.getItem('imgup-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
        window.imgupToggleTheme = function() {
          var r = document.documentElement;
          var cur = r.getAttribute('data-theme');
          var sysLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var next;
          if (cur === 'light')      next = 'dark';
          else if (cur === 'dark')  next = 'light';
          else                       next = sysLight ? 'dark' : 'light';
          r.setAttribute('data-theme', next);
          try { localStorage.setItem('imgup-theme', next); } catch (e) {}
        };
      })();

    :javascript
      // copy-to-clipboard for the contact-grid icon buttons. each .copy-icon-btn
      // carries its snippet text on data-copy-text.
      document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('click', function(e) {
          var btn = e.target.closest('.copy-icon-btn');
          if (!btn) return;
          e.preventDefault();
          var text = btn.dataset.copyText;
          if (text === undefined) return;

          var done = function(ok) {
            btn.classList.toggle('is-copied', ok);
            btn.classList.toggle('is-failed', !ok);
            setTimeout(function() {
              btn.classList.remove('is-copied', 'is-failed');
            }, 1400);
          };

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function(){done(true);}, function(){done(false);});
          } else {
            try {
              var ta = document.createElement('textarea');
              ta.value = text;
              ta.style.position = 'fixed'; ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              var ok = document.execCommand('copy');
              document.body.removeChild(ta);
              done(ok);
            } catch (err) { done(false); }
          }
        });

        // lightbox — click any .contact-card__photo to open
        var dialog = document.getElementById('lightbox');
        if (dialog) {
          var img = dialog.querySelector('.lightbox__img');
          var closeBtn = dialog.querySelector('.lightbox__close');

          document.addEventListener('click', function(e) {
            var trigger = e.target.closest('.contact-card__photo');
            if (!trigger) return;
            var src = trigger.dataset.lightboxSrc;
            var alt = trigger.dataset.lightboxAlt || '';
            if (!src) return;
            img.src = src;
            img.alt = alt;
            if (typeof dialog.showModal === 'function') dialog.showModal();
            else dialog.setAttribute('open', 'open');
          });

          // close on backdrop click (the dialog itself is the backdrop area)
          dialog.addEventListener('click', function(e) {
            if (e.target === dialog) dialog.close();
          });
          if (closeBtn) closeBtn.addEventListener('click', function() { dialog.close(); });

          // free up the image when closing so we don't keep a big buffer in memory
          dialog.addEventListener('close', function() { img.src = ''; img.alt = ''; });
        }

        // drop-target on the upload form (enhances the file input)
        var form = document.getElementById('upload-form');
        var fileInput = document.getElementById('upload-file');
        if (form && fileInput) {
          var depth = 0;  // dragenter/leave fire for descendants too; track nesting
          var setActive = function(on) { form.classList.toggle('is-drop-target', !!on); };
          ['dragenter','dragover'].forEach(function(ev) {
            form.addEventListener(ev, function(e) {
              if (!e.dataTransfer || !Array.from(e.dataTransfer.types || []).includes('Files')) return;
              e.preventDefault();
              if (ev === 'dragenter') depth++;
              setActive(true);
            });
          });
          form.addEventListener('dragleave', function(e) {
            depth = Math.max(0, depth - 1);
            if (depth === 0) setActive(false);
          });
          form.addEventListener('drop', function(e) {
            if (!e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) return;
            e.preventDefault();
            depth = 0; setActive(false);
            var dt = new DataTransfer();
            dt.items.add(e.dataTransfer.files[0]);
            fileInput.files = dt.files;
            fileInput.dispatchEvent(new Event('change', { bubbles: true }));
          });
          // also stop the browser from navigating away when dropping outside the form
          ['dragover','drop'].forEach(function(ev) {
            window.addEventListener(ev, function(e) {
              if (e.dataTransfer && Array.from(e.dataTransfer.types || []).includes('Files')) {
                if (!form.contains(e.target)) e.preventDefault();
              }
            });
          });
        }

        // a quiet hello to anyone who opens the console.
        try {
          if (console && console.log) {
            console.log('%cimgup', 'font: 700 18px/1 ui-serif, Georgia, serif; color: #b8463b; letter-spacing: -0.02em;');
            console.log('%csafelight on. shoot something.', 'color: #888; font: 12px/1.4 ui-monospace, Menlo, monospace;');
          }
        } catch (e) {}
      });
  %body
    %header
      %h1.weblog-title
        %a{href: "/"}
          %i.fa-image.fa-solid.meteor
          imgup
      
      
      = haml :"_partials/app_nav"
          
    %main

      =yield

    %dialog#lightbox.lightbox
      %button.lightbox__close{type: "button", "aria-label" => "close"}
        %i.fa-solid.fa-xmark
      %img.lightbox__img{src: "", alt: ""}

    %footer
      %p
        made by
        %a{href: "https://mph.omg.lol"} mph
        ·
        %button.theme-toggle{type: "button",
                              onclick: "imgupToggleTheme()",
                              "aria-label" => "toggle theme",
                              title: "toggle theme"}
          %i.fa-solid.fa-circle-half-stroke