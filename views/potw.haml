.contact-grid
  - @recents.each_with_index do |r, i|
    - frontmatter = "---\n" \
                    "title:  'Picture of the Week: #{r[:title]}'\n" \
                    "potw_img_url: #{r[:potw_img_url]}\n" \
                    "potw_alt: #{r[:potw_alt]}\n" \
                    "potw_gallery_link:  #{r[:potw_gallery_link]}\n" \
                    "date: #{Time.now.strftime("%Y-%m-%dT%H:%M:%S%z")}\n" \
                    "tags: ['PotW','photography']\n" \
                    "images:\n" \
                    "  - #{r[:potw_img_url]}\n\n" \
                    "draft: true\n" \
                    "---\n"
    %article.contact-card
      %span.contact-card__seq= "%02d" % (i + 1)
      %button.contact-card__photo{type: "button",
                                   "data-lightbox-src" => r[:potw_img_url],
                                   "data-lightbox-alt" => r[:potw_alt].to_s,
                                   "aria-label" => "view potw photo larger"}
        .photo-frame
          %img.contact-card__thumb{src: r[:thumb], alt: r[:potw_alt].to_s, loading: "lazy"}
      .contact-card__copy-row
        %button.copy-icon-btn{type: "button",
                                "data-copy-text" => frontmatter,
                                "aria-label" => "copy hugo frontmatter",
                                title: "copy hugo frontmatter"}
          %i.fa-solid.fa-rectangle-list
