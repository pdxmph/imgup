- if @access_token
  %form#upload-form.upload-form{action: "/upload_smugmug", enctype: "multipart/form-data", method: "POST"}
    .field
      %label.upload-label{for: "upload-title"} title
      %input#upload-title{name: "title", type: "text",
                           placeholder: "what to call this one",
                           autofocus: true, autocomplete: "off"}/
    .field
      %label.upload-label{for: "upload-caption"}
        caption
        %span.upload-hint  · used as alt text
      %input#upload-caption{name: "caption", type: "text",
                             placeholder: "what's in the frame",
                             autocomplete: "off"}/
    .field
      %label.upload-label{for: "upload-file"} photo
      %input#upload-file{name: "file", type: "file", accept: "image/*", required: true}/
    %input#upload-submit{type: "submit", value: "upload"}/
    %p#upload-status.upload-status
      uploading to smugmug — this can take a moment.

  :javascript
    (function() {
      var form  = document.getElementById('upload-form');
      var file  = document.getElementById('upload-file');
      var btn   = document.getElementById('upload-submit');
      var note  = document.getElementById('upload-status');
      var MAX   = 150 * 1024 * 1024; // 150 MB ceiling

      form.addEventListener('submit', function(e) {
        if (!file.files || !file.files[0]) {
          e.preventDefault();
          alert('pick a file first.');
          return;
        }
        var f = file.files[0];
        if (f.size > MAX) {
          e.preventDefault();
          alert('that file is ' + Math.round(f.size / 1024 / 1024) + ' MB. cap is 150 MB.');
          return;
        }
        if (!/^image\//.test(f.type)) {
          e.preventDefault();
          alert('that is not an image. (' + (f.type || 'unknown type') + ')');
          return;
        }
        // prevent double-submit while the upload is in flight
        btn.disabled = true;
        btn.value    = 'uploading…';
        note.classList.add('is-active');
      });
    })();

-else
  %p.signin-prompt
    not signed in to smugmug yet.
  %a.signin-btn{href: "/request"}
    %i.fa-solid.fa-passport
    sign in →
